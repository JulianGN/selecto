{
  "name": "selecto-chrome-extension",
  "version": "1.1.5",
  "description": "Chrome Extension for Selecto",
  "private": true,
  "scripts": {
    "copy-sdk": "node -e \"require('fs').copyFileSync('../../packages/selector-sdk/selector-sdk.js', './selector-sdk.js')\"",
    "build": "npm run copy-sdk",
    "dev": "npm run copy-sdk",
    "pack": "node ../../scripts/pack-extension.mjs",
    "pack:patch": "node ../../scripts/pack-extension.mjs patch",
    "pack:minor": "node ../../scripts/pack-extension.mjs minor"
  }
}
